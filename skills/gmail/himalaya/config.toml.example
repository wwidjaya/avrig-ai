display-name = "Wirianto Widjaja"

[accounts.gmail]
default = true
email = "YOUR_EMAIL@gmail.com"
display-name = "Wirianto Widjaja"

# Gmail REST API backend. `ortie token show` hands himalaya a live OAuth 2.0
# access token (auto-refreshed); Gmail only accepts OAuth bearer tokens.
gmail.auth.token.command = ["ortie", "token", "show", "-a", "gmail"]
# gmail.user-id = "me"   # defaults to "me", the authenticated account

# Friendly mailboxes for the shared commands (-m). Raw Gmail label ids work too.
mailbox.alias.inbox = "INBOX"
mailbox.alias.sent = "SENT"
mailbox.alias.drafts = "DRAFT"
mailbox.alias.trash = "TRASH"
mailbox.alias.archive = "ALL_MAIL"
mailbox.alias.spam = "SPAM"
mailbox.alias.starred = "STARRED"
mailbox.alias.important = "IMPORTANT"

# Optional — send from a verified mailing-list-style alias:
#   email = "list@yourdomain.com"
# Gmail still requires the authenticated (primary) account; use --from only
# for addresses configured as "Send mail as" in Gmail settings.

# Second Google Workspace account. Add one `[accounts.<alias>]` block per
# mailbox; match <alias> with ortie's `-a` account and the wrapper's
# `-Account`. Tokens live in ~/.config/ortie/<alias>.token.json.
# [accounts.composync]
# email = "you@yourworkspace.com"
# display-name = "Wirianto Widjaja"
# gmail.auth.token.command = ["ortie", "token", "show", "-a", "composync"]
# mailbox.alias.inbox = "INBOX"
# mailbox.alias.sent = "SENT"
# mailbox.alias.drafts = "DRAFT"
# mailbox.alias.trash = "TRASH"
# mailbox.alias.archive = "ALL_MAIL"
# mailbox.alias.spam = "SPAM"
# mailbox.alias.starred = "STARRED"
# mailbox.alias.important = "IMPORTANT"